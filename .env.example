# S-IT Hub — environment (copy to .env.local and fill in)
#
# NEVER commit .env.local. It is git-ignored.
# The app itself never sees these values: only the local dev proxy (server/ai-proxy.mjs)
# and the Supabase Edge Function use them.

# --- Assistant (local browser preview) ---
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Port for the local dev proxy (optional, default 8787)
AI_PROXY_PORT=8787

# --- Supabase (optional; enables cloud sync + the deployed assistant) ---
# EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
