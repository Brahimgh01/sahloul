    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@expo/metro-runtime": "~57.0.16",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-ml-kit/text-recognition": "2.0.0",
    "@react-navigation/bottom-tabs": "7.20.0",
    "@react-navigation/native": "7.5.0",
    "@react-navigation/native-stack": "7.20.0",
    "date-fns": "4.4.0",
    "expo": "57.0.27",
    "expo-application": "57.0.3",
    "expo-asset": "57.0.19",
    "expo-audio": "57.0.5",
    "expo-build-properties": "57.0.22",
    "expo-camera": "~57.0.6",
    "expo-clipboard": "57.0.2",
    "expo-constants": "57.0.21",
    "expo-dev-client": "57.0.19",
    "expo-document-picker": "57.0.3",
    "expo-file-system": "57.0.7",
    "expo-font": "57.0.4",
    "expo-haptics": "57.0.3",
    "expo-image-picker": "57.0.20",
    "expo-linking": "57.0.12",
    "expo-localization": "57.0.2",
    "expo-media-library": "57.0.5",
    "expo-notifications": "57.0.22",
    "expo-print": "57.0.2",
    "expo-secure-store": "57.0.4",
    "expo-sharing": "57.0.22",
